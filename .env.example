# ============================================
# .env.example — Template pour SMART_SCHOOL_FINAL
# ============================================
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter les valeurs réelles

# --- Base de données PostgreSQL ---
# Local/Docker :
DATABASE_URL=postgresql+pg8000://admin:change-me-password@localhost:5432/mydb
# Supabase (pooler transaction, port 6543 — recommandé, voir GUIDE_DEPLOIEMENT.md) :
# DATABASE_URL=postgresql+pg8000://postgres.<project-ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Redis (cache dashboard + file de tâches RQ, Étape F/G) ---
# Local/Docker :
REDIS_URL=redis://localhost:6379/0
# Render : rempli automatiquement par render.yaml (fromService), ne pas saisir à la main.

# --- Authentification JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Serveur ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8500
CORS_ORIGINS=http://localhost:3000,http://localhost:3333,http://127.0.0.1:3000

# --- SMS / Notifications (AfricasTalking) ---
AFRICASTALKING_API_KEY=change-me-api-key
AFRICASTALKING_USERNAME=change-me-username

# --- Production Security ---
ENVIRONMENT=production
LOG_LEVEL=info
WORKERS=4
