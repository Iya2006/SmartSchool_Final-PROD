# ============================================================================
# SMARTSCHOOL — Configuration du backend
#
# Copier ce fichier en `.env` et adapter. `.env` n'est pas versionné : il
# contient les mots de passe de la base et la clé de signature des jetons.
#
# ATTENTION AUX TROIS VALEURS QUI DOIVENT S'ACCORDER ENTRE ELLES
# Un désaccord entre elles ne produit pas une erreur claire : l'écran de
# connexion affiche « Identifiants incorrects » alors que le mot de passe
# n'a jamais quitté le navigateur. C'est arrivé, et ça a coûté une heure.
#
#   BACKEND_PORT              le port sur lequel l'API écoute
#   CORS_ORIGINS              doit contenir l'adresse EXACTE du frontend
#   frontend/.env.local       NEXT_PUBLIC_API_URL doit pointer sur ce port
#
# Le frontend tourne sur 3300 (voir START.bat) : si son adresse ne figure
# pas dans CORS_ORIGINS, le navigateur bloque toutes les requêtes avant même
# de les envoyer, avec « Disallowed CORS origin » côté serveur.
# ============================================================================

# ── Base de données ──
DATABASE_URL=postgresql+pg8000://smartschool:motdepasse@localhost:5433/smartschool

# ── Sécurité ──
# Générer une valeur propre en production : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changez-cette-valeur-en-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Réseau ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8300
# Toutes les adresses depuis lesquelles le navigateur a le droit d'appeler
# l'API. Le port du frontend DOIT y figurer, en http et sur les deux noms
# d'hôte (localhost et 127.0.0.1 ne sont pas la même origine pour un
# navigateur).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3300,http://127.0.0.1:3300

ENVIRONMENT=development

# ── File d'attente (tâches longues : calculs de moyennes, PDF) ──
REDIS_URL=redis://localhost:6379/0

# ── Pool de connexions ──
# Contrainte à respecter : workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW) doit
# rester sous le `max_connections` de PostgreSQL (100 par défaut).
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
