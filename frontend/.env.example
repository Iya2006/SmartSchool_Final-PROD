# ============================================
# .env.example — Frontend SmartSchool (Next.js)
# ============================================
# Copier en .env.local pour le développement, ou définir directement dans
# les variables d'environnement du projet Vercel pour la production.
#
# IMPORTANT : NEXT_PUBLIC_API_URL est intégrée au build (pas lue au runtime
# côté serveur) — elle doit être définie AVANT `npm run build`. Sans elle,
# le code retombe sur des valeurs codées en dur qui NE correspondent PAS
# au port réel du backend en production (8500) — voir GUIDE_DEPLOIEMENT.md.

# URL publique de l'API backend (Render en production, localhost en dev) :
NEXT_PUBLIC_API_URL=http://localhost:8500
